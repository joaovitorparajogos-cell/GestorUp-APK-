      "subcollections": {
        "colaboradores": {
          "rules": "request.auth != null"
        },
        "escalas_diarias": {
          "rules": "request.auth != null"
        },
        "anotacoes_diarias": {
          "rules": "request.auth != null"
        },
        "escalas_mensais": {
          "rules": "request.auth != null"
        },
        "pendencias": {
          "rules": "request.auth != null"
        }
      }
    }
  }
}
